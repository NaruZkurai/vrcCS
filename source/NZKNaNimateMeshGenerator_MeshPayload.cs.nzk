#if UNITY_EDITOR
namespace NZK
{
public static partial class Core
{
public static partial class NZKNaNimateMeshGenerator {
sealed class MeshPayload
    {
        public string leaf;
        public string rendererPath;
        public string rendererName;
        /*
         * The vertex data, copied from the source mesh.
         *
         * A FAITHFUL copy produced by Instantiate, not a hand-enumerated
         * field list. The previous implementation rebuilt the Mesh channel by
         * channel and silently dropped skinning whenever
         * `mesh.boneWeights.Length != mesh.vertexCount`, producing meshes with
         * `m_BoneWeights: 0` and a single identity bind pose. Those rendered
         * in bind pose and ignored the armature entirely - "visually
         * identical" was false even though every renderer reported swapped.
         * Instantiate carries every channel (weights, bind poses, colours,
         * blend shapes) with nothing to get wrong.
         */
        public UnityEngine.Mesh mesh;
        /* Source mesh name, the .meta.nzk pairing key. */
        public string meshName;
        /*
         * The renderer this payload came from. Held directly so the bone rewire
         * never has to re-derive it from a path, which can collide once
         * several model roots are merged into one list.
         */
        public UnityEngine.SkinnedMeshRenderer sourceRenderer;
    }
}
}
}
}
#endif
