/* ==========================================================================
 * NZK.Core.MA — ported Modular Avatar nanimation machinery.
 *
 * PROVENANCE
 *   Derived from `bdunderscore/modular-avatar`, specifically
 *   `Editor/ReactiveObjects/MeshFiltering/NaNimationFilter.cs` and
 *   `Editor/MeshVertexCopyUtil.cs`.  The algorithm is theirs and is correct;
 *   this file is a REDUCTION of it to the minimum this toolkit needs.
 *
 * WHAT WAS REMOVED, AND WHY THAT IS SOUND
 *   The original is built as a general framework: a pluggable `IMeshSelector`
 *   (vertex filters by axis, UV tile, bone, mask, shape...), `MeshSelectorJob`
 *   with Unity Jobs + Burst + `NativeArray` mesh access, and NDMF's
 *   `ObjectRegistry` for preview-object lifetime.
 *
 *   None of that is load-bearing for the one thing we do.  We are told which
 *   bones and meshes to nanimate; we do not need a filter registry, and 39
 *   meshes do not need job parallelism.  What IS load-bearing - and is
 *   reproduced faithfully below - is the MESH SURGERY:
 *
 *     1. split vertices so each primitive can carry its own visibility group
 *     2. create a DEDICATED bone per group
 *     3. move the influences onto those bones
 *     4. append the matching bind pose for every new bone
 *     5. put the animated bone behind a buffer object
 *
 *   Steps 1-5 are the technique.  Everything else was scaffolding.
 *
 * WHY THE ORIGINAL'S APPROACH IS THE RIGHT ONE
 *   We previously drove an EXISTING armature bone with NaN and relied on the
 *   authored vertex group being at 1e-7.  It's the most difficult way for these
 *   reasons:
 *     - Unity clamps ModelImporter.minBoneWeight to 0.001 and cannot be
 *       configured around it, so 1e-7 does not survive import; and must be scene only
 *       data only
 *     - scaling a bone that also carries real skin influences DRAGS the surface
 *       toward the group origin instead of hiding it
 *     - with no vertex splitting, a primitive that is only partly selected
 *       cannot be hidden without taking its neighbours with it.
 *       Meaning we need a negligable pull, I personally notice it a
 *       little bit above 0.00001 at long distances from bone;
 *       
 *   Creating a dedicated bone solves all three at once: the driven bone carries
 *   ONLY the vertices that should vanish. this is what is done in blender but the
 *   unity importer causes manual values to be normalised and on occasion skipped
 *   the future mechanism for this is going to be a blendshape and not weights for    
 *   easier detection and assignment
 *
 * NO AssetDatabase IN THIS FILE
 *   Every edit is in memory.  The repaired mesh is attached to the renderer and
 *   becomes part of the scene, so it is serialised when the scene is saved -
 *   which is what lets VRChat upload it.  Nothing is written as an asset, so no
 *   importer runs and no postprocess callback fires.
 *
 * STYLE
 *   No using directives, fully-qualified types, matching the rest of the
 *   toolkit.  See the other .cs.nzk files for why.
 * ========================================================================== */

#if UNITY_EDITOR
namespace NZK
{
public static partial class Core
{
  /** <summary>Modular Avatar derived nanimation machinery, reduced to essentials.
   *
   *  See the file header for provenance and for what was removed.</summary> */
  public static partial class MA
  {
    /** <summary>A bone created for one visibility group.
     *
     *  `originalBoneIndex` names the bone whose influence was moved; the new
     *  bone inherits its bind pose and its position in the hierarchy, so the
     *  geometry does not move when the influence is reassigned.</summary> */
    public struct AddedBone
    {
      public System.Int32 originalBoneIndex;
      public System.Int32 newBoneIndex;
    }

    /** <summary>One visibility group: the vertices it owns, and the bone to drive.
     *
     *  PLURAL BONES, because one group can need more than one.  A vertex carries
     *  at most four influences; if all four are real and none belongs to the
     *  group's first bone, the group has to claim a second bone to reach that
     *  vertex.  The original has the same property - `ComputeNaNPlanForShape`
     *  loops until `remainingVertices` is empty, adding a bone per pass. */
    public sealed class Group
    {
      /** The name of the group, which becomes the bone's name. */
      public System.String name;
      /** Vertices this group must be able to hide. */
      public System.Collections.Generic.HashSet<System.Int32> vertices =
        new System.Collections.Generic.HashSet<System.Int32>();
      /** Bones allocated to this group, in creation order. */
      public System.Collections.Generic.List<AddedBone> bones =
        new System.Collections.Generic.List<AddedBone>();
      /** The EXISTING armature bone under NaNimations that the clip drives.
       *
       *  The new bones hang UNDER this one, so the clip's NaN scale propagates
       *  down to them.  They must NOT be reparented onto the mesh's influence
       *  bone: that bone is an ordinary rig bone (Hips, Spine, a toe), and
       *  renaming or re-owning it corrupts the rig. */
      public UnityEngine.Transform nanimationBone;
    }

    /* ── RESULT ──────────────────────────────────────────────────────── */

    /** <summary>What a nanimation pass did.</summary> */
    public struct Report
    {
      /** Meshes examined. */
      public System.Int32 MeshesInspected;
      /** Meshes actually rebuilt (some vertices split and/or bones added). */
      public System.Int32 MeshesRebuilt;
      /** Vertices duplicated to give primitives independent visibility. */
      public System.Int32 VerticesSplit;
      /** Bones created across all meshes. */
      public System.Int32 BonesCreated;
      /** Buffer objects created (one per distinct parent bone). */
      public System.Int32 BuffersCreated;
      /** Meshes skipped because they had no group assignment. */
      public System.Int32 MeshesSkipped;
      /** Non-null when the pass could not proceed at all. */
      public System.String error;

      /** One-line summary, so a ucli reflection call prints something readable
       *  instead of the type name (`NZK.Core+MA+Report`). */
      public override System.String ToString()
      { return nameof(MeshesInspected) + "=" + MeshesInspected +
               " " + nameof(MeshesRebuilt) + "=" + MeshesRebuilt +
               " " + nameof(VerticesSplit) + "=" + VerticesSplit +
               " " + nameof(BonesCreated) + "=" + BonesCreated +
               " " + nameof(BuffersCreated) + "=" + BuffersCreated +
               " " + nameof(MeshesSkipped) + "=" + MeshesSkipped +
               " error=" + (error ?? ""); }
    }

    /* ── BLENDSHAPE-DRIVEN ENTRY POINT ───────────────────────────────── */

    /** <summary>Turn this renderer's blendshapes into nanimation groups.
     *
     *  THE AUTHORING CONTRACT, and it is deliberately this simple:
     *
     *    - In Blender, a garment's vertex group becomes a BLENDSHAPE with the
     *      same name as the bone that should drive it.
     *    - A vertex belongs to the group if the shape MOVES it, i.e. its delta
     *      is non-zero.
     *    - The shape's scale-to-zero trick is the authoring marker; what matters
     *      here is only which vertices the shape touches.
     *
     *  WHY BLENDSHAPES AND NOT VERTEX GROUPS, stated because it is the whole
     *  reason for this rework:
     *
     *  Unity clamps `ModelImporter.minBoneWeight` to 0.001 and REFUSES every
     *  write path to change it (SerializedObject, the native typed setter,
     *  WriteImportSettingsIfDirty, ImportAsset(ForceUpdate), a .meta
     *  reserialize, and editing the .meta by hand - writing 0.01 reads back as
     *  0.001).  A vertex GROUP authored at 1e-7 therefore cannot survive the
     *  importer, and nothing downstream can recover a value that was dropped at
     *  import time.
     *
     *  A BLENDSHAPE is not subject to that clamp.  Measured on this project:
     *  `Top - Corset` retains its shapes and `Laced Top` still moves 600 of
     *  2435 vertices.  So the shape is a reliable CARRIER for "which vertices
     *  belong to this garment", which a weight cannot be.
     *
     *  THE SHAPE IS USED ONLY AS A SELECTOR.  The hiding is still done by a
     *  dedicated bone scaled to NaN, because a blendshape can only MOVE
     *  geometry - it cannot make a vertex non-finite, so it cannot make the GPU
     *  discard a triangle.  Selection and hiding are therefore two different
     *  mechanisms and this method joins them.
     *
     *  NAME MATCHING, and why it is not equality.  Measured names on this
     *  avatar: shapes are `Bodysuit`, `Jeans`, `Skirt`, `Tech Jacket`; bones are
     *  `NaNimate Bodysuit`, `NaNimate Jeans`, `NaNimate Skirt`,
     *  `NaNimate Leather Jacket`.  Only `NaNimate Stockings` matches exactly.
     *  So the match is: strip an optional `NaNimate `/`Nanimate ` prefix from EITHER
     *  side, then compare case-insensitively.  A shape with no matching bone is
     *  REPORTED, not silently dropped - a garment that does not toggle because
     *  its bone is named differently is exactly the silent failure this whole
     *  investigation was about.</summary> */
    public static Report ApplyFromBlendShapes(
      UnityEngine.SkinnedMeshRenderer renderer,
      UnityEngine.Transform nanimationGroup)
    { Report report = new Report();
      if (renderer == null) { report.error = "renderer is null"; return report; }
      UnityEngine.Mesh mesh = renderer.sharedMesh;
      if (mesh == null) { report.error = "renderer has no mesh"; return report; }
      if (nanimationGroup == null) { report.error = "no NaNimations group given"; return report; }
      if (mesh.blendShapeCount == 0) { report.MeshesSkipped = 1; return report; }

      /* IDEMPOTENCY.  Re-running the tool must not stack a second set of NaN
       * bones on the same mesh - which is what happened when the report bug was
       * fixed and the pass ran twice but reported success both times
       * (`BEFORE bones=228` on the second run).  Detect our own output by the
       * name every influence bone we create carries. */
      UnityEngine.Transform[] existing = renderer.bones;
      for (System.Int32 b = 0; b < existing.Length; b++)
      { UnityEngine.Transform t = existing[b];
        if (t == null) continue;
        if (t.name.StartsWith("__NZK_NanimBone_",System.StringComparison.Ordinal))
        { report.MeshesSkipped = 1;
          report.error = "already processed: bone '" + t.name + "'";
          return report; } }

      report.MeshesInspected = 1;

      /* Bone lookup by NORMALISED name, so the matching rule lives in exactly
       * one place and cannot drift between the resolve and the report. */
      System.Collections.Generic.Dictionary<System.String,UnityEngine.Transform> boneByName =
        new System.Collections.Generic.Dictionary<System.String,UnityEngine.Transform>(System.StringComparer.OrdinalIgnoreCase);
      for (System.Int32 i = 0; i < nanimationGroup.childCount; i++)
      { UnityEngine.Transform b = nanimationGroup.GetChild(i);
        if (b == null) continue;
        System.String key = NormaliseName(b.name);
        if (!boneByName.ContainsKey(key)) boneByName[key] = b; }

      System.Collections.Generic.List<Group> groups = new System.Collections.Generic.List<Group>();
      System.Collections.Generic.List<System.String> unmatched = new System.Collections.Generic.List<System.String>();
      System.Int32 vertCount = mesh.vertexCount;
      UnityEngine.Vector3[] dPos = new UnityEngine.Vector3[vertCount];
      UnityEngine.Vector3[] dNrm = new UnityEngine.Vector3[vertCount];
      UnityEngine.Vector3[] dTan = new UnityEngine.Vector3[vertCount];

      for (System.Int32 si = 0; si < mesh.blendShapeCount; si++)
      { System.String shapeName = mesh.GetBlendShapeName(si);
        /* Fusion shapes and Blender's leftover Basis are not garments. */
        if (System.String.IsNullOrEmpty(shapeName)) continue;
        if (NZK.S.HasOIC(shapeName,"Basis")) continue;

        if (!boneByName.TryGetValue(NormaliseName(shapeName),out UnityEngine.Transform bone))
        { unmatched.Add(shapeName); continue; }

        /* FIRST FRAME ONLY.  A nanimation shape is a membership marker, not an
         * animation - every frame would describe the same vertices, and reading
         * frame 0 keeps the cost to one pass per shape. */
        mesh.GetBlendShapeFrameVertices(si,0,dPos,dNrm,dTan);
        Group g = new Group { name = bone.name, nanimationBone = bone };
        for (System.Int32 v = 0; v < vertCount; v++)
        { /* A vertex belongs when the shape DISPLACES it.  The epsilon is well
           * below any authored garment motion (measured deltas run 1.7e-5 to
           * 4.7e-3) and well above float noise, so a vertex that is merely
           * numerically touched is not counted as a member. */
          if (dPos[v].sqrMagnitude > 1e-12f ||
              dNrm[v].sqrMagnitude > 1e-12f ||
              dTan[v].sqrMagnitude > 1e-12f)
            g.vertices.Add(v); }
        if (g.vertices.Count == 0) continue;
        groups.Add(g); }

      if (groups.Count == 0)
      { report.MeshesSkipped = 1;
        if (unmatched.Count > 0)
          report.error = "no blendshape matched a bone under '" + nanimationGroup.name +
                         "'. Unmatched: " + System.String.Join(", ",unmatched.ToArray());
        return report; }

      /* Call Rebuild DIRECTLY, passing this report by ref.  Going through
       * `Apply` would start a fresh Report and lose the shaping counts gathered
       * above - which is exactly how a pass that created 25 bones reported
       * BonesCreated=0.  One pass, one Report. */
      System.Boolean anySelection = false;
      for (System.Int32 g = 0; g < groups.Count; g++)
        if (groups[g] != null && groups[g].vertices.Count > 0) { anySelection = true; break; }
      if (!anySelection) { report.MeshesSkipped = 1; return report; }

      System.String err = null;
      System.Collections.Generic.Dictionary<System.String,System.Collections.Generic.List<UnityEngine.GameObject>> made =
        Rebuild(renderer,mesh,groups,ref report,out err);
      if (!NZK.B.NoE(err)) { report.error = err; return report; }

      /* The bones `Rebuild` made are parented into the scene; nothing else to
       * do here.  Shaping counts and surgery counts are already in `report`. */
      return report; }

    /** <summary>Strip an optional NaNimate prefix and lowercase, for name matching.
     *
     *  Handles the spellings observed in this project: `NaNimate X`, `Nanimate X`
     *  and a bare `X`.  The prefix is removed from BOTH sides of a comparison, so
     *  `Bodysuit` matches `NaNimate Bodysuit` and also `NaNimate Bodysuit`
     *  matches `NaNimate Bodysuit` without either being special-cased. */
    public static System.String NormaliseName(System.String name)
    { if (!NZK.S.Has(name)) return name;
      System.String s = name.Trim();
      /* Case-insensitive prefix strip.  Checked rather than replaced blindly so
       * a garment genuinely called "Nanimate..." cannot be mangled twice. */
      if (s.Length > 9 && NZK.S.HasOIC(s.Substring(0,9),"nanimate "))
        s = s.Substring(9).Trim();
      return s.ToLowerInvariant(); }

    /* ── ENTRY POINT ─────────────────────────────────────────────────── */

    /** <summary>Apply every group's nanimation to one renderer's mesh, in memory.
     *
     *  Groups are keyed by the source bone index they should hide; the caller
     *  supplies which vertices belong to which group (that is the Blender-side
     *  authoring, and this file deliberately does not care how it was decided).
     *
     *  RetURNS the created bones grouped by name, so the caller can hand them to
     *  the animation side.  Nothing is written to disk.
     *
     *  SHARED MESHES.  If two renderers point at the same mesh, each needs its
     *  own copy once it has its own bones - the bone assignment lives on the
     *  RENDERER, not the mesh, so a shared mesh would otherwise be driven by
     *  whichever renderer ran last.  The caller passes a mesh it owns; this
     *  method replaces `renderer.sharedMesh` and never mutates the input. */
    public static Report Apply(
      UnityEngine.SkinnedMeshRenderer renderer,
      System.Collections.Generic.List<Group> groups)
    { Report report = new Report();
      if (renderer == null) { report.error = "renderer is null"; return report; }
      UnityEngine.Mesh source = renderer.sharedMesh;
      if (source == null) { report.error = "renderer has no mesh"; return report; }
      if (groups == null || groups.Count == 0) { report.error = "no groups given"; return report; }

      /* Same idempotency guard as ApplyFromBlendShapes: a renderer already
       * carrying one of our bones has been processed and must not be stacked on. */
      UnityEngine.Transform[] existing = renderer.bones;
      for (System.Int32 b = 0; b < existing.Length; b++)
      { UnityEngine.Transform t = existing[b];
        if (t == null) continue;
        if (t.name.StartsWith("__NZK_NanimBone_",System.StringComparison.Ordinal))
        { report.MeshesSkipped = 1;
          report.error = "already processed: bone '" + t.name + "'";
          return report; } }

      report.MeshesInspected = 1;

      /* Only vertices that actually need splitting force a rebuild.  A mesh with
       * no group assignment at all is left alone, which is what keeps a mesh the
       * user did not opt in from being rewritten. */
      System.Boolean anySelection = false;
      for (System.Int32 g = 0; g < groups.Count; g++)
        if (groups[g] != null && groups[g].vertices.Count > 0) { anySelection = true; break; }
      if (!anySelection) { report.MeshesSkipped = 1; return report; }

      System.String err = null;
      System.Collections.Generic.Dictionary<System.String,System.Collections.Generic.List<UnityEngine.GameObject>> made =
        Rebuild(renderer,source,groups,ref report,out err);
      if (err != null) { report.error = err; return report; }

      report.MeshesRebuilt = 1;
      return report; }

    /* ── THE SURGERY ─────────────────────────────────────────────────── */

    /** <summary>Rebuild the mesh and create the group bones.
     *
     *  THE ORDER IS THE ALGORITHM.  Each step depends on the previous:
     *    1. classify every vertex by which groups select it  -> hide keys
     *    2. decide, per primitive, whether its vertices can stay shared or must
     *       be duplicated so the primitive can be hidden independently
     *    3. build the new mesh with the duplicated vertices and remapped indices
     *    4. append the bone weights for the duplicated vertices
     *    5. allocate bones, move influences onto them, append bind poses
     *    6. build the bone GameObjects behind a buffer object per parent
     *
     *  Doing 5 before 3 breaks the bind poses (they are indexed by the OLD
     *  vertex layout); doing 6 before 5 leaks bones nothing references. */
    static System.Collections.Generic.Dictionary<System.String,System.Collections.Generic.List<UnityEngine.GameObject>> Rebuild(
      UnityEngine.SkinnedMeshRenderer renderer,
      UnityEngine.Mesh mesh,
      System.Collections.Generic.List<Group> groups,
      ref Report report,
      out System.String error)
    { error = null;
      report.MeshesRebuilt = 1;
      System.Collections.Generic.Dictionary<System.String,System.Collections.Generic.List<UnityEngine.GameObject>> result =
        new System.Collections.Generic.Dictionary<System.String,System.Collections.Generic.List<UnityEngine.GameObject>>(System.StringComparer.Ordinal);
      if (!mesh.isReadable)
      { error = "mesh '" + mesh.name + "' is not readable; enable Read/Write on the model";
        return result; }

      UnityEngine.Transform[] bones = renderer.bones;
      if (bones == null || bones.Length == 0)
      { error = "renderer '" + renderer.name + "' declares no bones"; return result; }

      /* ── 1. HIDE KEY PER VERTEX ────────────────────────────────────
       *
       * A bitmask over groups is enough and is what the original uses for up to
       * 64 groups (`SmallHideKey`).  We cap at 64 and report rather than
       * silently mis-group beyond that - a wrong hide key produces a garment
       * that hides with the wrong toggle, which is far worse than an error. */
      if (groups.Count > 64)
      { error = groups.Count + " groups exceeds the 64-group limit of this implementation";
        return result; }
      System.Int32 vertCount = mesh.vertexCount;
      System.UInt64[] hideKey = new System.UInt64[vertCount];
      for (System.Int32 gi = 0; gi < groups.Count; gi++)
      { Group g = groups[gi];
        if (g == null) continue;
        System.UInt64 bit = 1UL << gi;
        foreach (System.Int32 v in g.vertices)
          if (v >= 0 && v < vertCount) hideKey[v] |= bit; }

      /* ── 2. VERTEX SPLITTING ───────────────────────────────────────
       *
       * A vertex used by two primitives with DIFFERENT hide keys cannot serve
       * both: whichever key it carries, the other primitive hides wrongly.  Such
       * a vertex is duplicated and each primitive is pointed at its own copy.
       *
       * `newToOrig[newIdx] = origIdx`, and it starts as the identity - the
       * original's layout, with duplicates appended. */
      System.Collections.Generic.List<System.Int32> newToOrig =
        new System.Collections.Generic.List<System.Int32>(vertCount);
      System.Collections.Generic.List<System.UInt64> newHideKey =
        new System.Collections.Generic.List<System.UInt64>(vertCount);
      for (System.Int32 v = 0; v < vertCount; v++) { newToOrig.Add(v); newHideKey.Add(hideKey[v]); }

      System.Int32 subMeshCount = mesh.subMeshCount;
      System.Int32[][] indices = new System.Int32[subMeshCount][];
      for (System.Int32 sm = 0; sm < subMeshCount; sm++)
        indices[sm] = mesh.GetTriangles(sm);

      /* cloneMap[(origVert, hideKey)] -> the duplicate that carries that key. */
      System.Collections.Generic.Dictionary<System.Int64,System.Int32> cloneMap =
        new System.Collections.Generic.Dictionary<System.Int64,System.Int32>();

      for (System.Int32 sm = 0; sm < subMeshCount; sm++)
      { System.Int32[] tri = indices[sm];
        /* Every 3 indices form one primitive.  The primitive's hide key is the
         * AND of its vertices' keys: a primitive is hidden only by a group that
         * selects ALL of its vertices.  Intersecting rather than taking the
         * first vertex's key is what stops a group from dragging in a triangle
         * that merely touches one selected vertex. */
        for (System.Int32 p = 0; p + 2 < tri.Length; p += 3)
        { System.UInt64 key = hideKey[tri[p]] & hideKey[tri[p+1]] & hideKey[tri[p+2]];
          if (key == 0) continue;   /* not selected by any group: leave shared */
          for (System.Int32 k = 0; k < 3; k++)
          { System.Int32 ov = tri[p+k];
            if (newHideKey[ov] == key) continue;   /* already carries this key */
            System.Int64 mapKey = ((System.Int64)ov << 32) | (System.Int64)(System.UInt32)key;
            if (!cloneMap.TryGetValue(mapKey,out System.Int32 dup))
            { dup = newToOrig.Count;
              newToOrig.Add(ov);
              newHideKey.Add(key);
              cloneMap[mapKey] = dup;
              report.VerticesSplit++; }
            tri[p+k] = dup; } } }

      /* ── 2b. ONE GROUP PER VERTEX ───────────────────────────────────
       *
       * The triangle pass above only splits where a PRIMITIVE's key differs, so
       * a vertex no triangle rewrote can still carry SEVERAL group bits.  That
       * is the partial-nanimation corruption: the first group claims it and
       * zeroes its other influences, every later group then finds a vertex with
       * no usable influence, drops it as "cannot be hidden", and that garment
       * keeps vertices that never react to its toggle.  The surface stretches
       * instead of vanishing - the "drooping" the user reported, present in
       * EDIT mode too because it is baked into the weights, not the animation.
       *
       * Fix: split every multi-bit vertex into one copy per bit, then repoint
       * the triangles that use it.  A triangle needs the copy carrying the one
       * group that selects it, so its own AND-key decides - the lowest bit
       * present is the group whose toggle must be able to hide it.
       *
       * PERFORMANCE, and it matters here.  Repointing inside the per-vertex
       * loop meant scanning every triangle for every split vertex: on this mesh
       * 13018 vertices against ~12000 triangles is ~156 million iterations, and
       * the editor stopped responding entirely.  So the two halves are separated
       * - build the clone table first, then walk the triangles exactly ONCE and
       * redirect each index it contains.  O(V + T) instead of O(V x T). */
      System.Collections.Generic.List<System.UInt64> splitFirstBit =
        new System.Collections.Generic.List<System.UInt64>();
      System.Collections.Generic.List<System.Collections.Generic.Dictionary<System.UInt64,System.Int32>> splitClones =
        new System.Collections.Generic.List<System.Collections.Generic.Dictionary<System.UInt64,System.Int32>>();
      for (System.Int32 v = 0; v < newToOrig.Count; v++)
      { System.UInt64 key = newHideKey[v];
        System.UInt64 rest = key;
        System.Int32 bits = 0;
        while (rest != 0) { bits += (System.Int32)(rest & 1UL); rest >>= 1; }
        /* The parallel lists are indexed by the ORIGINAL vertex id, so pad them
         * for every vertex seen so far - clones appended below are already
         * single-bit and never need an entry of their own. */
        if (bits <= 1) { splitFirstBit.Add(0UL); splitClones.Add(null); continue; }

        System.UInt64 firstBit = key & (System.UInt64)(-(System.Int64)key);
        newHideKey[v] = firstBit;
        splitFirstBit.Add(firstBit);

        System.Collections.Generic.Dictionary<System.UInt64,System.Int32> bitToVert =
          new System.Collections.Generic.Dictionary<System.UInt64,System.Int32>();
        System.UInt64 remain = key & ~firstBit;
        while (remain != 0)
        { System.UInt64 one = remain & (System.UInt64)(-(System.Int64)remain);
          System.Int32 dup = newToOrig.Count;
          newToOrig.Add(newToOrig[v]);
          newHideKey.Add(one);
          bitToVert[one] = dup;
          report.VerticesSplit++;
          remain &= ~one; }
        splitClones.Add(bitToVert); }

      /* One pass over every triangle, redirecting each index that belongs to a
       * split vertex.  Safe to do after all clones exist. */
      for (System.Int32 sm3 = 0; sm3 < subMeshCount; sm3++)
      { System.Int32[] t3 = indices[sm3];
        for (System.Int32 p3 = 0; p3 + 2 < t3.Length; p3 += 3)
        { /* The triangle's AND-key names the single group that selects it. */
          System.UInt64 triKey = newHideKey[t3[p3]] & newHideKey[t3[p3+1]] & newHideKey[t3[p3+2]];
          for (System.Int32 k3 = 0; k3 < 3; k3++)
          { System.Int32 vi = t3[p3+k3];
            if (vi < 0 || vi >= splitClones.Count) continue;
            System.Collections.Generic.Dictionary<System.UInt64,System.Int32> map = splitClones[vi];
            if (map == null) continue;                 /* not a split vertex */
            System.UInt64 own = splitFirstBit[vi];
            if ((triKey & own) != 0) continue;         /* original is the right copy */
            System.UInt64 hit = triKey & ~own;
            if (hit == 0) continue;                    /* selected by no group */
            System.UInt64 one = hit & (System.UInt64)(-(System.Int64)hit);
            if (!map.TryGetValue(one,out System.Int32 target3)) continue;
            t3[p3+k3] = target3; } } }

      /* ── 3. NEW MESH ──────────────────────────────────────────────── */
      UnityEngine.Mesh rebuilt = new UnityEngine.Mesh();
      rebuilt.name = mesh.name;
      rebuilt.indexFormat = newToOrig.Count > 65535
        ? UnityEngine.Rendering.IndexFormat.UInt32
        : mesh.indexFormat;
      System.Int32[] newToOrigArray = newToOrig.ToArray();
      TransferVertexData(rebuilt,mesh,newToOrigArray);
      rebuilt.bindposes = mesh.bindposes;
      TransferShapes(rebuilt,mesh,newToOrigArray);
      rebuilt.subMeshCount = subMeshCount;
      for (System.Int32 sm = 0; sm < subMeshCount; sm++)
        rebuilt.SetTriangles(indices[sm],sm,false);

      /* ── 4. WEIGHT EXTENSION ───────────────────────────────────────
       *
       * `GetAllBoneWeights` is a flat array plus a per-vertex count; the
       * duplicated vertices need the SOURCE vertex's weights appended in the
       * same encoding before anything can be moved onto a new bone.
       *
       * THESE ARE NativeArray AT THE SOURCE, and Unity's API only accepts
       * NativeArray back on `SetBoneWeights`.  Copying into a managed array
       * would round-trip the whole skinning dataset twice on a 39-mesh avatar
       * for no benefit, so the data is converted ONCE into managed arrays here
       * and converted back once at the write - the algorithm needs indexed
       * read/write, which a managed array gives without the safety-handle
       * ceremony. */
      Unity.Collections.NativeArray<UnityEngine.BoneWeight1> srcWeights = mesh.GetAllBoneWeights();
      Unity.Collections.NativeArray<System.Byte> srcPerVertex = mesh.GetBonesPerVertex();
      UnityEngine.BoneWeight1[] allWeights = new UnityEngine.BoneWeight1[srcWeights.Length];
      srcWeights.CopyTo(allWeights);
      System.Byte[] bonesPerVertex = new System.Byte[srcPerVertex.Length];
      srcPerVertex.CopyTo(bonesPerVertex);
      System.Int32 origCount = vertCount;
      System.Int32 newCount = newToOrig.Count;
      System.Int32 cloneCount = newCount - origCount;

      System.Int32[] firstBone = new System.Int32[origCount];
      { System.Int32 run = 0;
        for (System.Int32 v = 0; v < origCount; v++) { firstBone[v] = run; run += bonesPerVertex[v]; } }

      System.Int32 extra = 0;
      for (System.Int32 c = 0; c < cloneCount; c++)
        extra += bonesPerVertex[newToOrig[origCount + c]];

      UnityEngine.BoneWeight1[] extW = new UnityEngine.BoneWeight1[allWeights.Length + extra];
      System.Array.Copy(allWeights,extW,allWeights.Length);
      System.Byte[] extB = new System.Byte[newCount];
      System.Array.Copy(bonesPerVertex,extB,origCount);
      { System.Int32 w = allWeights.Length;
        for (System.Int32 c = 0; c < cloneCount; c++)
        { System.Int32 ov = newToOrig[origCount + c];
          System.Int32 n = bonesPerVertex[ov];
          extB[origCount + c] = (System.Byte)n;
          System.Int32 baseIdx = firstBone[ov];
          for (System.Int32 b = 0; b < n; b++) extW[w++] = allWeights[baseIdx + b]; } }

      /* Recompute the offsets over the EXTENDED vertex set: every later step
       * indexes weights by new vertex, and using the original offsets here
       * reads the wrong influences for every duplicated vertex. */
      System.Int32[] firstBoneNew = new System.Int32[newCount];
      { System.Int32 run = 0;
        for (System.Int32 v = 0; v < newCount; v++) { firstBoneNew[v] = run; run += extB[v]; } }

      /* ── 5. ALLOCATE BONES AND MOVE INFLUENCES ─────────────────────
       *
       * One bone at a time: take the group's vertices still needing a bone,
       * pick the influence they share most often, and repoint it at a NEW bone.
       * Repeat until the group's vertices are all covered - the loop exists
       * because a vertex with four real influences may need a fourth-candidate
       * bone before one of its slots can be donated. */
      System.Int32 nextBone = mesh.bindposes == null ? 0 : mesh.bindposes.Length;
      System.Int32 firstNewBone = nextBone;
      for (System.Int32 gi = 0; gi < groups.Count; gi++)
      { Group g = groups[gi];
        if (g == null || g.vertices.Count == 0) continue;
        System.UInt64 bit = 1UL << gi;

        System.Collections.Generic.List<System.Int32> remaining =
          new System.Collections.Generic.List<System.Int32>();
        for (System.Int32 v = 0; v < newCount; v++)
          if ((newHideKey[v] & bit) != 0) remaining.Add(v);

        while (remaining.Count > 0)
        { /* Count which bones the remaining vertices already use, most common
           * first: repointing the most-shared influence covers the most
           * vertices per new bone, which keeps the bone count down. */
          System.Collections.Generic.Dictionary<System.Int32,System.Int32> freq =
            new System.Collections.Generic.Dictionary<System.Int32,System.Int32>();
          for (System.Int32 i = 0; i < remaining.Count; i++)
          { System.Int32 v = remaining[i];
            for (System.Int32 b = 0; b < extB[v]; b++)
            { UnityEngine.BoneWeight1 bw = extW[firstBoneNew[v] + b];
              if (bw.weight == 0f) continue;
              if (bw.boneIndex < 0) continue;
              /* ONLY ORIGINAL BONES ARE VALID CANDIDATES.  A bone we created
               * earlier in this same loop already sits at index >=
               * firstNewBone, and selecting it would do two wrong things at
               * once: the bind pose lookup would read a slot that still holds
               * mesh-local garbage (or a pose we are about to overwrite), and
               * the group's vertices would end up chained onto another group's
               * bone instead of their own.  Measured symptom of allowing it:
               * bind pose `(-0.0581, 0.3881, -0.0454)` against a live position
               * of `(0.0546, -0.0067, 0.3912)` - not related by the rig's
               * rotation, so the garment translated away from the body. */
              if (bw.boneIndex >= firstNewBone) continue;
              freq.TryGetValue(bw.boneIndex,out System.Int32 n);
              freq[bw.boneIndex] = n + 1; } }
          if (freq.Count == 0)
          { /* Vertices selected but carrying no influence at all.  They cannot
             * be hidden by a bone, so they are dropped from the group; the
             * alternative is an infinite loop choosing a bone that does not
             * exist. */
            remaining.Clear();
            break; }

          System.Int32 target = -1; System.Int32 best = -1;
          foreach (System.Collections.Generic.KeyValuePair<System.Int32,System.Int32> kv in freq)
            if (kv.Value > best) { best = kv.Value; target = kv.Key; }
          AddedBone added = new AddedBone { originalBoneIndex = target, newBoneIndex = nextBone++ };
          g.bones.Add(added);
          report.BonesCreated++;

          /* MOVE, DO NOT SHARE.
           *
           * The first version repointed ONE influence at the new bone and left
           * the vertex's other influences alone.  That is what produced the
           * "drooping sleeve" corruption: a vertex then blends a FINITE rig
           * influence with a NaN influence, and a linear blend of a real
           * position with NaN is not NaN - the finite term drags the vertex part
           * of the way, so the surface stretches into a spear instead of
           * vanishing.  Measured on the test avatar: 5614 of 7649 vertices had
           * mixed influences and the render showed exactly that stretching.
           *
           * A vertex can only be hidden by a bone if that bone is its WHOLE
           * influence - NaN * 1 = NaN, but NaN * 0.3 + p * 0.7 is finite.  So
           * the claimed influence is set to weight 1 and every other influence
           * on that vertex is zeroed. */
          for (System.Int32 i = remaining.Count - 1; i >= 0; i--)
          { System.Int32 v = remaining[i];
            System.Boolean claimed = false;
            for (System.Int32 b = 0; b < extB[v]; b++)
            { System.Int32 at = firstBoneNew[v] + b;
              UnityEngine.BoneWeight1 bw = extW[at];
              if (bw.weight == 0f || bw.boneIndex != target) continue;

              /* Zero every other slot FIRST, while the slot positions are still
               * stable, then claim this one.  Writing as we scan would make a
               * later slot's index depend on whether an earlier one was zeroed. */
              for (System.Int32 k = 0; k < extB[v]; k++)
              { System.Int32 kat = firstBoneNew[v] + k;
                if (kat == at) continue;
                UnityEngine.BoneWeight1 other = extW[kat];
                other.weight = 0f;
                other.boneIndex = 0;
                extW[kat] = other; }

              bw.weight = 1f;
              bw.boneIndex = added.newBoneIndex;
              extW[at] = bw;
              claimed = true;
              break; }
            if (claimed) remaining.RemoveAt(i); } } }

      /* ── 5b. BIND POSE ARRAY SIZE ─────────────────────────────────
       *
       * Only the SIZE is settled here.  Bind poses describe where a bone sits
       * in the REST pose, as `renderer.worldToLocalMatrix * bone.localToWorld`
       * at author time.  A new bone hangs under the group's nanimation bone, so
       * its truthful pose cannot be known until the GameObject exists - section
       * 6 fills the matrix in.  Resizing to `nextBone` here also guarantees the
       * array is never longer than the bones that use it, which is the mismatch
       * that produced NaN vertices in the previous implementation. */
      UnityEngine.Matrix4x4[] poses = mesh.bindposes;
      /* Snapshot BEFORE the resize: `Array.Resize` may reuse the same backing
       * store, so read the originals once here for section 6b to inherit. */
      UnityEngine.Matrix4x4[] originalPoses = mesh.bindposes;
      System.Array.Resize(ref poses,nextBone);
      UnityEngine.Matrix4x4[] mesh_poses = poses;
      /* SetBoneWeights takes NativeArray, so the managed result is handed back
       * once here - see the note in section 4 for why the round trip is done
       * deliberately rather than threaded through the whole algorithm. */
      using (Unity.Collections.NativeArray<System.Byte> outB =
               new Unity.Collections.NativeArray<System.Byte>(extB.Length,Unity.Collections.Allocator.Temp))
      using (Unity.Collections.NativeArray<UnityEngine.BoneWeight1> outW =
               new Unity.Collections.NativeArray<UnityEngine.BoneWeight1>(extW.Length,Unity.Collections.Allocator.Temp))
      { outB.CopyFrom(extB);
        outW.CopyFrom(extW);
        rebuilt.SetBoneWeights(outB,outW); }

      /* ── 6. BONE OBJECTS ──────────────────────────────────────────
       *
       * EVERY NEW BONE HANGS OFF A BUFFER OBJECT, one per distinct parent:
       *
       *     <original bone>
       *       └── NZK_NanimBuffer_<n>       scale stays 1, absorbs parent scale
       *            └── <group name>         animates 1 -> NaN
       *
       * WHY THE BUFFER EXISTS.  The animation curve is baked against the bone's
       * local scale being 1.  Anything that rescales the RIG (a merge step, a
       * user scaling the armature) would change that bone's scale and the curve
       * would no longer reach NaN - the toggle would silently stop working.  The
       * buffer takes the scale change instead, so the animated bone stays at
       * exactly 1.  This mirrors the original's `NaNimatedBuffer` and the bug it
       * cites (bdunderscore/modular-avatar#1869). */
      UnityEngine.Transform[] newBones = new UnityEngine.Transform[nextBone];
      System.Array.Copy(renderer.bones,newBones,System.Math.Min(renderer.bones.Length,nextBone));
      System.Collections.Generic.Dictionary<UnityEngine.Transform,UnityEngine.Transform> bufferFor =
        new System.Collections.Generic.Dictionary<UnityEngine.Transform,UnityEngine.Transform>();

      for (System.Int32 gi = 0; gi < groups.Count; gi++)
      { Group g = groups[gi];
        if (g == null || g.bones.Count == 0) continue;
        /* THE CHAIN HANGS UNDER THE NANIMATION BONE THE CLIP DRIVES:
         *
         *     Armature/NaNimations/NaNimate Jeans      <- existing, clip target
         *       └── NZK_NanimBuffer_<n>               <- scale 1, absorbs rig scale
         *            └── __NZK_NanimBone_<group>_<i>  <- wields the vertex influence
         *
         *  The FIRST PORT PARENTED THE BUFFER TO THE MESH'S INFLUENCE BONE and
         *  renamed that bone to steal the group's path.  That influence bone is
         *  an ordinary rig bone - `vrc.Hips`, `vrc.Spine`, a toe - so the rename
         *  hit the RIG (observed: `__NZK_Original_vrc.Hips`), and the new bone
         *  sat on a path no clip targets.  Parenting under the nanimation bone
         *  fixes both: the rig is untouched and the clip's NaN scale reaches the
         *  influence bone by ordinary transform inheritance. */
        UnityEngine.Transform anchor = g.nanimationBone;
        if (anchor == null) continue;

        if (!bufferFor.TryGetValue(anchor,out UnityEngine.Transform buffer))
        { UnityEngine.GameObject bufferObj = new UnityEngine.GameObject("NZK_NanimBuffer_" + report.BuffersCreated);
          buffer = bufferObj.transform;
          buffer.SetParent(anchor,false);
          buffer.localPosition = UnityEngine.Vector3.zero;
          buffer.localRotation = UnityEngine.Quaternion.identity;
          buffer.localScale = UnityEngine.Vector3.one;
          bufferFor[anchor] = buffer;
          report.BuffersCreated++; }

        System.Collections.Generic.List<UnityEngine.GameObject> created =
          new System.Collections.Generic.List<UnityEngine.GameObject>();
        for (System.Int32 b = 0; b < g.bones.Count; b++)
        { AddedBone ab = g.bones[b];
          /* The child bone carries the influence.  It takes a NEUTRAL interior
           * name: the clip drives the nanimation bone ABOVE the buffer, and the
           * NaN scale reaches this bone through the buffer, so naming it after
           * the group would only create a second object claiming to be the
           * toggle target.  The index still distinguishes several bones of one
           * group. */
          UnityEngine.GameObject boneObj = new UnityEngine.GameObject(
            "__NZK_NanimBone_" + g.name + "_" + b);
          UnityEngine.Transform boneT = boneObj.transform;
          boneT.SetParent(buffer,false);

          UnityEngine.Transform original =
            ab.originalBoneIndex >= 0 && ab.originalBoneIndex < renderer.bones.Length
              ? renderer.bones[ab.originalBoneIndex] : null;
          if (original != null)
          { /* PLACE THE BONE AT ITS OWN BIND POSE, SO THE SKIN MATRIX IS THE
             * IDENTITY AND THE VERTEX DOES NOT MOVE.
             *
             * MEASURED, and this is the whole answer.  On this rig the live and
             * bind transforms of one bone disagree by the rig's POSE, not by a
             * fixed axis conversion.  Bone `vrc.Hand_L`:
             *
             *     live = (-0.4481,  0.0205,  1.0399)
             *     bind = ( 0.1411, -0.2946, -1.0844)
             *     live^-1 * bind = 2.2 m of translation
             *
             * Copying the live transform while inheriting the bind pose therefore
             * reproduces the HAND'S deformation - and since this shape selects
             * sleeve vertices, it dragged the jacket across 2.2 m.  Every
             * earlier attempt at this was one half of that pair.
             *
             * A skin matrix is `bone.worldToLocal * bindpose`.  To leave a vertex
             * exactly where it is, the product must be the IDENTITY, which needs
             * the bone's live transform to BE the transform its bind pose
             * describes:
             *
             *     boneWorld = renderer.localToWorldMatrix * bindpose[original]
             *
             * So the bone is placed THERE, and section 6b gives it exactly that
             * bind pose.  The pair then cancels, the rest pose is untouched, and
             * the only thing that ever moves these vertices is the NaN scale the
             * clip drives through the buffer above. */
            UnityEngine.Matrix4x4 wantWorld = renderer.localToWorldMatrix * originalPoses[ab.originalBoneIndex];
            UnityEngine.Vector3 wantPos = wantWorld.GetColumn(3);
            UnityEngine.Quaternion wantRot = wantWorld.rotation;
            UnityEngine.Vector3 wantScale = wantWorld.lossyScale;
            boneT.SetPositionAndRotation(wantPos, wantRot);
            for (System.Int32 pass = 0; pass < 3; pass++)
            { UnityEngine.Vector3 have = boneT.lossyScale;
              if (have.x == 0f || have.y == 0f || have.z == 0f) break;
              UnityEngine.Vector3 cur = boneT.localScale;
              boneT.localScale = new UnityEngine.Vector3(
                cur.x * wantScale.x / have.x,
                cur.y * wantScale.y / have.y,
                cur.z * wantScale.z / have.z); } }
          else
          { boneT.localPosition = UnityEngine.Vector3.zero;
            boneT.localRotation = UnityEngine.Quaternion.identity;
            boneT.localScale = UnityEngine.Vector3.one; }

          newBones[ab.newBoneIndex] = boneT;
          created.Add(boneObj); }
        if (created.Count > 0) result[g.name] = created; }

      /* ── 6b. BIND POSES FROM THE PLACEMENT ABOVE ──────────────────
       *
       * Derived, never inherited.  `bindposes[i]` is where bone `i` sat in the
       * rest pose, expressed in the renderer's local space, and a skin matrix
       * is `bone.worldToLocal * bindposes[i]`.  That product is the identity
       * only when the bind pose describes the transform the bone actually has,
       * so the pose is READ OFF the transform that was just set rather than
       * copied from the original bone.  Copying the original's pose while the
       * new bone stood somewhere else is precisely the 0.79 m disagreement
       * measured earlier (bone at origin, pose claiming the far end of a leg),
       * and it is what speared the garments.
       *
       * ASSIGNING THE ORIGINAL'S POSE IS THEREFORE ONLY SAFE IF THE BONE IS
       * ALSO PLACED AT THE ORIGINAL'S WORLD TRANSFORM, which section 6 does.
       * The two are computed from the same source, so they cannot disagree. */
      for (System.Int32 gi = 0; gi < groups.Count; gi++)
      { Group g = groups[gi];
        if (g == null) continue;
        for (System.Int32 b = 0; b < g.bones.Count; b++)
        { AddedBone ab = g.bones[b];
          if (ab.newBoneIndex < 0 || ab.newBoneIndex >= mesh_poses.Length) continue;
          UnityEngine.Transform t = newBones[ab.newBoneIndex];
          if (t == null) { mesh_poses[ab.newBoneIndex] = UnityEngine.Matrix4x4.identity; continue; }
          /* DERIVED FROM THE PLACEMENT, so `live^-1 * bind` cancels to the
           * identity and the claimed vertices stay exactly where they are.
           *
           * Section 6 put this bone at `renderer.localToWorld * bindpose[orig]`,
           * so reading the pose back off it reproduces that same matrix and the
           * two cancel.  Inheriting the original's pose instead is only
           * equivalent when the placement matched the original's LIVE transform,
           * which on a posed rig it does not (measured: `vrc.Hand_L` live
           * `(-0.4481, 0.0205, 1.0399)` vs bind `(0.1411, -0.2946, -1.0844)`,
           * a 2.2 m skin translation that dragged the jacket with it). */
          mesh_poses[ab.newBoneIndex] = renderer.worldToLocalMatrix * t.localToWorldMatrix; } }
      rebuilt.bindposes = mesh_poses;

      renderer.bones = newBones;
      renderer.sharedMesh = rebuilt;
      return result; }

    /* ── VERTEX STREAM COPY ────────────────────────────────────────── */

    /** <summary>Copy every vertex attribute stream, duplicating as indexed.
     *
     *  `newToOrig[newIdx] = origIdx`, duplicates allowed.
     *
     *  THIS EXISTS RATHER THAN `Mesh.Instantiate` OR A CHANNEL-BY-CHANNEL COPY,
     *  and the reason is measured: writing a mesh through the per-channel API
     *  (`copy.vertices = ...`, `copy.uv = ...`) can lose the SKINNING stream
     *  when the result is serialised, and a mesh without it is refused by the
     *  GPU upload.  Reading and writing the raw vertex BUFFERS preserves the
     *  exact stream layout the source had, including any channel we do not know
     *  about by name.
     *
     *  This is the original `MeshVertexCopyUtil.TransferVertexData`, unchanged
     *  in behaviour.</summary> */
    public static void TransferVertexData(UnityEngine.Mesh dst,UnityEngine.Mesh src,System.Int32[] newToOrig)
    { UnityEngine.Rendering.VertexAttributeDescriptor[] attrs = src.GetVertexAttributes();
      dst.SetVertexBufferParams(newToOrig.Length,attrs);
      for (System.Int32 stream = 0; stream < 4; stream++)
      { System.Int32 stride = src.GetVertexBufferStride(stream);
        if (stride == 0) continue;
        UnityEngine.GraphicsBuffer srcBuf = src.GetVertexBuffer(stream);
        System.Byte[] origData = new System.Byte[stride * src.vertexCount];
        srcBuf.GetData(origData);
        System.Byte[] newData = new System.Byte[stride * newToOrig.Length];
        for (System.Int32 v = 0; v < newToOrig.Length; v++)
          System.Array.Copy(origData,newToOrig[v] * stride,newData,v * stride,stride);
        dst.SetVertexBufferData(newData,0,0,newData.Length,stream); } }

    /** <summary>Copy every blendshape frame, duplicating vertices as indexed.
     *
     *  Shapes must be re-emitted because the vertex count changed: a shape frame
     *  is one delta per vertex, so a duplicated vertex needs its own entry or
     *  the shape would address the wrong vertices.
     *
     *  All three channels are copied.  A shape carrying only position deltas
     *  still moves the silhouette but leaves the shading behind, which reads as
     *  a region that moves without lighting correctly.
     *
     *  This is the original `MeshVertexCopyUtil.TransferShapes`.</summary> */
    public static void TransferShapes(UnityEngine.Mesh dst,UnityEngine.Mesh src,System.Int32[] newToOrig)
    { dst.ClearBlendShapes();
      System.Int32 newCount = newToOrig.Length;
      UnityEngine.Vector3[] oPos = new UnityEngine.Vector3[src.vertexCount];
      UnityEngine.Vector3[] nPos = new UnityEngine.Vector3[newCount];
      UnityEngine.Vector3[] oNrm = new UnityEngine.Vector3[src.vertexCount];
      UnityEngine.Vector3[] nNrm = new UnityEngine.Vector3[newCount];
      UnityEngine.Vector3[] oTan = new UnityEngine.Vector3[src.vertexCount];
      UnityEngine.Vector3[] nTan = new UnityEngine.Vector3[newCount];
      for (System.Int32 s = 0; s < src.blendShapeCount; s++)
      { System.String name = src.GetBlendShapeName(s);
        System.Int32 frames = src.GetBlendShapeFrameCount(s);
        for (System.Int32 f = 0; f < frames; f++)
        { src.GetBlendShapeFrameVertices(s,f,oPos,oNrm,oTan);
          for (System.Int32 i = 0; i < newCount; i++)
          { nPos[i] = oPos[newToOrig[i]];
            nNrm[i] = oNrm[newToOrig[i]];
            nTan[i] = oTan[newToOrig[i]]; }
          dst.AddBlendShapeFrame(name,src.GetBlendShapeFrameWeight(s,f),nPos,nNrm,nTan); } } }
  }
}
}
#endif
