#if UNITY_EDITOR
namespace NZK.NaNimate
{
    /// <summary>
    /// Remote console for the v6 toolkit, so an automated session can drive the
    /// editor without a human clicking menus.
    ///
    /// WHY: the v6 tree had no command channel. `Assets/NZK toolkit v6/remote_cmd.txt`
    /// existed but nothing read it - the only listener was v4's RemoteConsole,
    /// bound to v4's own file. Writing "compile" there therefore did nothing at
    /// all, which silently wasted several diagnostic rounds.
    ///
    /// A command line is treated as NEW when it differs from the previous content,
    /// so re-issuing the same verb requires writing something different in between
    /// (append a counter, or clear the file first).
    ///
    /// Commands (one per line; '#' comments ignored):
    ///   ping                              liveness + PID
    ///   compile                           request a script recompilation
    ///   generate &lt;modelPath&gt; &lt;avatarName&gt;  run the generator immediately
    ///   diagnose &lt;prefabPath&gt;             dump real renderer/mesh state
    ///   log &lt;message&gt;                     echo into the Editor log
    /// </summary>
    [UnityEditor.InitializeOnLoad]
    public static class NZKNaNimateRemoteConsole
    {
        const string CmdFile = "Assets/NZK toolkit v6/remote_cmd.txt";

        static string _lastContent;
        static double _lastCheck;

        static NZKNaNimateRemoteConsole()
        {
            try
            {
                if (!System.IO.File.Exists(CmdFile))
                {
                    System.IO.File.WriteAllText(
                        CmdFile,
                        "# NZK v6 Remote Console\n" +
                        "# Commands: ping, compile, generate <modelPath> <avatarName>, diagnose <prefabPath>, log <msg>\n");
                }

                _lastContent = System.IO.File.ReadAllText(CmdFile);
            }
            catch (System.Exception e)
            {
                UnityEngine.Debug.LogWarning("[NZK NaNimate] Remote console init failed: " + e.Message);
                return;
            }

            UnityEditor.EditorApplication.update += OnUpdate;
            UnityEngine.Debug.Log("[NZK NaNimate] Remote console listening: " + CmdFile);
        }

        static void OnUpdate()
        {
            // Poll at ~2 Hz. Cheap: one file read, and only re-parses on change.
            if (UnityEditor.EditorApplication.timeSinceStartup - _lastCheck < 0.5)
                return;

            _lastCheck = UnityEditor.EditorApplication.timeSinceStartup;

            if (!System.IO.File.Exists(CmdFile))
                return;

            string current;
            try
            {
                current = System.IO.File.ReadAllText(CmdFile);
            }
            catch (System.Exception)
            {
                // A write in progress can transiently lock the file; skip this tick.
                return;
            }

            if (current == _lastContent)
                return;

            string[] oldLines = _lastContent.Split('\n');
            string[] newLines = current.Split('\n');
            _lastContent = current;

            for (int i = 0; i < newLines.Length; i++)
            {
                string t = newLines[i].Trim();
                if (t.Length == 0 || t.StartsWith("#"))
                    continue;

                bool isNew = true;
                for (int o = 0; o < oldLines.Length; o++)
                {
                    if (oldLines[o].Trim() == t)
                    {
                        isNew = false;
                        break;
                    }
                }

                if (!isNew)
                    continue;

                Execute(t);
            }
        }

        static void Execute(string cmd)
        {
            // A recompile tears down this domain, so it must run LAST and via
            // delayCall - calling it inline can abort the rest of this method.
            if (cmd == "compile" || cmd == "recompile")
            {
                UnityEngine.Debug.Log("[NZK NaNimate] Remote console: requesting recompile.");
                UnityEditor.EditorApplication.delayCall +=
                    () => UnityEditor.Compilation.CompilationPipeline.RequestScriptCompilation();
                return;
            }

            if (cmd == "ping")
            {
                UnityEngine.Debug.Log("[NZK NaNimate] pong - editor alive.");
                return;
            }

            if (cmd.StartsWith("log "))
            {
                UnityEngine.Debug.Log("[NZK NaNimate] " + cmd.Substring(4));
                return;
            }

            if (cmd.StartsWith("generate "))
            {
                string[] parts = cmd.Substring(9).Trim().Split(' ');
                if (parts.Length < 1 || parts[0].Length == 0)
                {
                    UnityEngine.Debug.LogError("[NZK NaNimate] generate needs <modelPath> [avatarName]");
                    return;
                }

                string modelPath = parts[0];
                string avatarName = parts.Length > 1 && parts[1].Length > 0
                    ? parts[1]
                    : System.IO.Path.GetFileNameWithoutExtension(modelPath);

                UnityEngine.Debug.Log("[NZK NaNimate] Remote console: generating for " +
                                      modelPath + " (" + avatarName + ")");

                try
                {
                    NZKNaNimateMeshGenerator.Result r =
                        NZKNaNimateMeshGenerator.GenerateNow(modelPath, avatarName);

                    if (r == null)
                        UnityEngine.Debug.LogError("[NZK NaNimate] generate returned null.");
                    else if (!r.success)
                        UnityEngine.Debug.LogError("[NZK NaNimate] generate FAILED: " + r.error);
                    else
                        UnityEngine.Debug.Log("[NZK NaNimate] generate OK: " + r.meshCount +
                                              " mesh(es), " + r.swappedCount + " swapped, " +
                                              r.unmappedBones + " unmapped bone(s), prefab " +
                                              r.prefabPath);
                }
                catch (System.Exception e)
                {
                    UnityEngine.Debug.LogError("[NZK NaNimate] generate threw: " + e);
                }

                return;
            }

            if (cmd.StartsWith("diagnose "))
            {
                string prefabPath = cmd.Substring(9).Trim();

                // Accept a model path and derive the prefab, so callers do not
                // have to know the output layout.
                if (!prefabPath.EndsWith(".prefab", System.StringComparison.OrdinalIgnoreCase))
                {
                    string avatar = System.IO.Path.GetFileNameWithoutExtension(prefabPath);
                    prefabPath = NZKNaNimateMeshFolder.PrefabFolderFor(prefabPath, avatar) +
                                 "/" + avatar + ".prefab";
                }

                UnityEngine.Debug.Log("[NZK NaNimate] Remote console: diagnosing " + prefabPath);
                NZKNaNimateDiagnostics.Diagnose(prefabPath);
                return;
            }

            UnityEngine.Debug.LogWarning("[NZK NaNimate] Remote console: unknown command '" + cmd + "'");
        }
    }
}
#endif
