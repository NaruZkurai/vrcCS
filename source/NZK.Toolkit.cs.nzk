/* ==========================================================================
 * NZK.Toolkit — Avatar-attachable component for the NZK baking pipeline.
 * This is the ONLY file outside C_NZKToolkit_monolith_compilable.cs.
 * All logic delegates to NZK.Core.* via fully qualified names.
 *
 * Bake methods are guarded with #if UNITY_EDITOR since they rely on
 * editor-only methods in the monolith (AssetDatabase, etc.).
 * Designed to be a ndmf and vrcfury replacement. for faster upload times :D
 * Designed to be a ndmf and vrcfury replacement. for faster upload times :D
 * Q: what is this ?
 * A: Designed to be a ndmf and vrcfury replacement. for faster upload times :D
 * faster tweaking, faster developement,
 * VRCFURY (VF) AND NDMF (or MA) rebuilds the avatar from scratch on EVERY SINGLE BUILD
 * but my system only updates components :D
 * you CAN rebuild everything but once its built u can upload to like 6 different ids without having to build 6 times if you wanted
 * Q: But if you change or add something to the Avi you would have to build it again before uploading right?
 * A: No when you are done editing it will only update the parts that you edited and thats tracked
 * Q: how do i merge old object references fast?
 * A: Multiselect, right click, merge objects and optionally merge children.
 * Q: are all the script paramiters scattered all over the place like vrcfury or modular avatar?
 * A: Only if you want. whenever you use anything in my toolkit if it creates objects,
 * -  it stores all your settings in a generator objectect named GEN_Avatarname,
 * -  then you can update anything you did here
 * Q: does this work without VF or NDMF or MA installed?
 * A: I intend on having both Systems Convertable and even usable without them installed.
 * - the user decides baking time
 * ========================================================================== */

namespace NZK{
  public partial class Core{

[UnityEngine.AddComponentMenu("NZK/Toolkit")]
public class C_NZKToolkit : UnityEngine.MonoBehaviour
{/* ── Avatar root (auto-finds from parent hierarchy) ──────────── */
 public UnityEngine.GameObject NZKTK_AviRoot;

 /* ── Higharchy Baker (C_AviGenerator) found on this or children ── */
 public C_AviGenerator NZKTK_ScriptableComponent;

 /* ── Bake toggles ────────────────────────────────────────────── */
 public System.Boolean bakeAviRoot = true;
 public System.Boolean bakeMesh = true;
 public System.Boolean bakeToggles = true;
 public System.Boolean bakeArmature = true;
 public System.Boolean bakeControllers = true;

 /* ── Read settings from existing monolith components ─────────── */
 void ReadFromExisting()
 { /* Sync bake toggles from AviLink if present */
  var link = AviLinkRegistry.Get(NZKTK_AviRoot);
  if (link != null)
  {
   bakeAviRoot = true;
   bakeMesh = true;
   bakeToggles = link.bakeToggles;
   bakeArmature = link.bakeArmatureLinks;
   bakeControllers = link.bakeFullController;
  }
  /* Sync from existing C_AviGenerator if present */
  if (NZKTK_ScriptableComponent != null) { NZKTK_ScriptableComponent.NZKC_GO_AviRoot = NZKTK_AviRoot; }
 }

 /* ── Auto-find on Reset / Start ──────────────────────────────── */
 void Reset()
 {
  if (NZKTK_AviRoot == null)
  {
   var t = (UnityEngine.Transform)GetComponent(typeof(UnityEngine.Transform));
   while (t.parent != null) t = t.parent;
   NZKTK_AviRoot = t.gameObject;
  }
  EnsureBaker();
 }

 /* ── Reload Higharchy Baker children ─────────────────────────── */
 public void ReloadBaker()
 {
  if (NZKTK_ScriptableComponent == null)
  {
   NZKTK_ScriptableComponent = AviGeneratorRegistry.Get(gameObject);
   if (NZKTK_ScriptableComponent == null) NZKTK_ScriptableComponent = AviGeneratorRegistry.Get(GetComponentInChildren<UnityEngine.Transform>());
  }
  if (NZKTK_ScriptableComponent != null) NZKTK_ScriptableComponent.ReloadChildren();
 }

 /* ── Ensure a Higharchy Baker on this object ─────────────────── */
 public C_AviGenerator EnsureBaker()
 {
  if (NZKTK_ScriptableComponent == null) NZKTK_ScriptableComponent = AviGeneratorRegistry.Get(gameObject);
  if (NZKTK_ScriptableComponent == null) NZKTK_ScriptableComponent = AviGeneratorRegistry.Get(GetComponentInChildren<UnityEngine.Transform>());
  if (NZKTK_ScriptableComponent == null)
  {
   NZKTK_ScriptableComponent = AviGeneratorRegistry.GetOrCreate(gameObject);
   NZKTK_ScriptableComponent.mode = E_AviGeneratorMode.This;
   NZKTK_ScriptableComponent.NZKC_GO_AviRoot = NZKTK_AviRoot;
   NZKTK_ScriptableComponent.ReloadChildren();
  }
  ReadFromExisting();
  return NZKTK_ScriptableComponent;
 }

#if UNITY_EDITOR
 /* ── Context menus (right-click component) ──────────────────── */
 [UnityEngine.ContextMenu("Bake All")] public void BakeAllCtx() => BakeAll();
 [UnityEngine.ContextMenu("Bake Avatar Root")] public void BakeAviRootCtx() => BakeAviRootOnly();
 [UnityEngine.ContextMenu("Bake Mesh")] public void BakeMeshCtx() => BakeMeshOnly();
 [UnityEngine.ContextMenu("Bake Armature")] public void BakeArmatureCtx() => BakeArmatureFinal();
 [UnityEngine.ContextMenu("Bake Expression Layers")] public void BakeExprCtx() => BakeExpressionLayers();
 [UnityEngine.ContextMenu("Bake FX Layers")] public void BakeFxCtx() => BakeFxLayers();
 [UnityEngine.ContextMenu("Bake Toggle Generator")] public void BakeToggleCtx() => BakeToggleGenerator();
 [UnityEngine.ContextMenu("Set Avatar Root")] public void SetRootCtx() => SetAviRoot();
 [UnityEngine.ContextMenu("Build Avatar from Armature")] public void BuildAvCtx() => BuildAvatarFromArmature();

 /* ── Component copy/paste clipboard ──────────────────────────────
    The clipboard and BOTH of its entry points moved to
    NZK.Core.RightClick (source/rightclick.cs.nzk): NZK Copy here, in the
    component context menu, and Paste Component as New there, in the toolbar.
    One clipboard in one place is the point - two copies of these fields would
    be two clipboards that disagree.

    Everything below this comment that is NOT a MenuItem is component API and
    stays: the [ContextMenu] shortcuts above are instance methods on this
    MonoBehaviour, and the editor-only bake entry points at the bottom are
    what the custom Inspector and the ContextMenu attributes call. */

#if UNITY_EDITOR
 /* ── Bake entry points are defined at the bottom of this file ── */
#endif

 /* ── GameObject context menus moved to NZK.Core.Toolbar ───────────
    Every GameObject/NZK/... item and its validator now lives in
    source/toolbar.cs.nzk.  They are static, reference nothing on this Editor
    instance, and were only ever here because this file happened to be the one
    that existed.  Removing them makes the toolbar surface readable in one
    place instead of interleaved with clipboard plumbing and SPS conversion.
    Behaviour is unchanged: the same menu paths, the same priorities, the same
    dispatcher calls - moved verbatim. */

 /* ── VRCFury / SPS conversion moved to NZK.Core.RightClick ────────
    The CONTEXT/... items, the VF GUID table, CopySpsProperties, HasFeature
    and EnsureSpsGenerator now live in source/rightclick.cs.nzk.  EnsureSpsGenerator
    is public because the toolbar's SPS items call it too.

    What STAYS here, deliberately: the [ContextMenu] attributes at the top of
    this class.  Those are instance methods on C_NZKToolkit - moving them would
    move the component's own methods, which changes the serialised shape of the
    component.  They are component shortcuts, not menu entries. */


 /* ── Bake entry points (editor-only) ─────────────────────────── */
 public void BakeAll()
 {if (!Validate()) return;
 AVController.BakeAll(NZKTK_ScriptableComponent);}

 public void BakeAviRootOnly()
 {if (!Validate()) return;
 AVController.BakeAviRoot(NZKTK_ScriptableComponent);}

 public void BakeMeshOnly()
 {if (!Validate()) return;
 MergeCore.BakeMesh(NZKTK_ScriptableComponent);}

 public void BakeExpressionLayers()
 {if (!Validate()) return;
 AVController.BakeExpressionLayers(NZKTK_ScriptableComponent);}

 public void BakeFxLayers()
 {if (!Validate()) return;
 AVController.BakeFxLayers(NZKTK_ScriptableComponent);}

 public void BakeToggleGenerator()
 {if (!Validate()) return;
 AVController.BakeToggleGenerator(NZKTK_ScriptableComponent);}

 public void SetAviRoot()
 {if (!Validate()) return;
 AVController.SetAviRoot(NZKTK_ScriptableComponent);}

 public void BuildAvatarFromArmature()
 {if (!Validate()) return;
 AVController.BuildAvatarFromArmature(NZKTK_ScriptableComponent);}

 public void ResetTransforms()
 {if (!Validate()) return;
 AVController.ResetTransforms(NZKTK_ScriptableComponent);}

 public void BakeArmatureFinal()
 {if (!Validate()) return;
 AVController.BakeArmatureFinal(NZKTK_ScriptableComponent);}
#endif

 /* ── Validation ──────────────────────────────────────────────── */
 System.Boolean Validate()
 {
  if (NZKTK_ScriptableComponent == null) { UnityEngine.Debug.LogWarning("[C_NZKToolkit] No Higharchy Baker found. Click 'Ensure Baker' first."); return false; }
  if (NZKTK_AviRoot == null) { UnityEngine.Debug.LogWarning("[C_NZKToolkit] No avatar root set."); return false; }
  return true;
 }
}

#if UNITY_EDITOR
[UnityEditor.CustomEditor(typeof(C_NZKToolkit))]
public class C_NZKToolkitEditor : UnityEditor.Editor
{C_NZKToolkit _t;
UnityEditor.SerializedProperty _spBaker;
UnityEditor.Editor _bakerEditor;

void OnEnable()
{_t = (C_NZKToolkit)target;
_spBaker = serializedObject.FindProperty("NZKTK_ScriptableComponent");}

void EnsureBakerEditor()
{if (_t.NZKTK_ScriptableComponent == null) { _bakerEditor = null; return; }
if (_bakerEditor == null || _bakerEditor.target != _t.NZKTK_ScriptableComponent)
{_bakerEditor = null;
UnityEditor.Editor.CreateCachedEditor(_t.NZKTK_ScriptableComponent,null,ref _bakerEditor);}}

public override void OnInspectorGUI()
{if (_t == null) return;
serializedObject.Update();
EnsureBakerEditor();

/* ── Avatar Root ── */
UnityEditor.EditorGUILayout.PropertyField(serializedObject.FindProperty("NZKTK_AviRoot"),new UnityEngine.GUIContent("Avatar Root"));

/* ── Baker component ── */
UnityEditor.EditorGUILayout.BeginHorizontal();
UnityEditor.EditorGUILayout.PropertyField(_spBaker,new UnityEngine.GUIContent("Higharchy Baker"));
if (UnityEngine.GUILayout.Button("Auto-Create",UnityEngine.GUILayout.Width(85)))
{_t.EnsureBaker();UnityEditor.EditorUtility.SetDirty(_t);EnsureBakerEditor();}
UnityEditor.EditorGUILayout.EndHorizontal();

/* ── Draw the full C_AviGenerator inspector (cached editor) ── */
if (_bakerEditor != null)
{UnityEditor.EditorGUILayout.Space(4);
_bakerEditor.OnInspectorGUI();}
else
{UnityEditor.EditorGUILayout.HelpBox("No Higharchy Baker. Click Auto-Create to add one.",UnityEditor.MessageType.Warning);}

/* ── Bake toggles ── */
UnityEditor.EditorGUILayout.Space(4);
UnityEditor.EditorGUILayout.LabelField("── Bake Options ──",UnityEditor.EditorStyles.boldLabel);
UnityEditor.EditorGUILayout.PropertyField(serializedObject.FindProperty("bakeAviRoot"),new UnityEngine.GUIContent("Bake Avatar Root"));
UnityEditor.EditorGUILayout.PropertyField(serializedObject.FindProperty("bakeMesh"),new UnityEngine.GUIContent("Bake Mesh"));
UnityEditor.EditorGUILayout.PropertyField(serializedObject.FindProperty("bakeToggles"),new UnityEngine.GUIContent("Bake Toggles"));
UnityEditor.EditorGUILayout.PropertyField(serializedObject.FindProperty("bakeArmature"),new UnityEngine.GUIContent("Bake Armature"));
UnityEditor.EditorGUILayout.PropertyField(serializedObject.FindProperty("bakeControllers"),new UnityEngine.GUIContent("Bake Controllers"));

serializedObject.ApplyModifiedProperties();}}
#endif
/* Expected User flow *\
* multiselect two objects right click, merge with children
* - unpacks first selected objects (if required),
* - replaces all references to target object's in the scene with the current ones
* - if there is any animations that target  that object specifically it duplicates thoes animations and regargets them
* - all script components get coppied as new, then updated, if theres a conflict it should ask the user to override or add as a new component with references. (should still turn all references to that object regardless)
*
* Select any object with VF sockets, right-click → NZK → SPS → Convert VRCFury Sockets to NZK, and each one gets:
*
*
* Component converted (VF → C_NzkSpsSocket with all serialized data)
* Generator created/connected (GEN_{avatar} → SPS GENERATOR)
* Config created under the generator
* Baked hierarchy + prefab generated
* FX controller merged if has linked controller
*
*
*
*
*
*
*
*
*
*/}}