  static System.Boolean HasFeature(UnityEngine.MonoBehaviour comp,System.String featureName) { var features = Systems.Baking.GetFeatures(comp); if (features == null) return false; foreach (var f in features) if (f != null && (f.GetType().Name == featureName || (f.GetType().FullName ?? "").Contains(featureName))) return true; UnityEngine.Debug.Log("[Baking] This VRCFury component doesn't have a " + featureName + " feature."); return false; }
