#if UNITY_EDITOR
namespace NZK
{
public static partial class Core
{
public partial class NZKNaNimateGroupManifest {
[System.Serializable]
        public sealed class Entry
        {
            public string name = string.Empty;
            public bool enabled;
            public System.Collections.Generic.List<MeshSelection> meshes = new System.Collections.Generic.List<MeshSelection>();
            public Entry() { }
            public Entry(string name, bool enabled, System.Collections.Generic.IEnumerable<string> meshes)
            {
                this.name = name;
                this.enabled = enabled;
                this.meshes = new System.Collections.Generic.List<MeshSelection>();
                if (meshes == null)
                    return;
                foreach (string mesh in meshes)
                    this.meshes.Add(new MeshSelection(mesh, enabled));
            }
            public bool IsMeshEnabled(string meshName)
            {
                MeshSelection sel = FindMesh(meshName);
                /* Absent means "not explicitly disabled", so defer to the group flag. */
                return sel == null ? enabled : sel.enabled;
            }
            public MeshSelection FindMesh(string meshName)
            {
                for (int i = 0; i < meshes.Count; i++)
                {
                    if (NZK.S.EqOIC(meshes[i].name, meshName))
                        return meshes[i];
                }
                return null;
            }
            public void SetMeshEnabled(string meshName, bool value)
            {
                MeshSelection sel = FindMesh(meshName);
                if (sel == null)
                {
                    meshes.Add(new MeshSelection(meshName, value));
                    return;
                }
                sel.enabled = value;
            }
            /* UnityEngine.Mesh names still selected after per-submesh removals. */
            public System.Collections.Generic.List<string> EnabledMeshes()
            {
                var result = new System.Collections.Generic.List<string>(meshes.Count);
                for (int i = 0; i < meshes.Count; i++)
                {
                    if (meshes[i].enabled)
                        result.Add(meshes[i].name);
                }
                return result;
            }
        }
}
}
}
}
#endif
