    for (int i = 0; i < 3; i++)
    vrcad.specialAnimationLayers[i] = new VRC.SDK3.Avatars.Components.VRCAvatarDescriptor.CustomAnimLayer { type = specialTypes[i],isEnabled = true,isDefault = true };
