/* ==========================================================================
 * NZK.Core.RightClick — every context-menu entry point (CONTEXT/...).
 *
 * TOOLBAR vs RIGHTCLICK
 *   Toolbar  = GameObject/NZK/...   the top menu bar, one entry per action.
 *   RightClick = CONTEXT/...        the component's own context menu, shown by
 *                                   right-clicking that component.
 *
 * THE FOUR SHAPES A USER ACTUALLY HAS
 *   Unity gives a context item no way to ask "was this a single or multi
 *   selection" - the item either appears in the menu or it does not.  So the
 *   four combinations the user named are produced by three mechanisms:
 *
 *     1. single select, Hierarchy object   -> CONTEXT/Component/NZK Copy
 *        (fires on the clicked Component; the menu is per-component, not
 *        per-object, so it is inherently single-target)
 *     2. multi select,  Hierarchy objects  -> GameObjects/NZK/... toolbar items
 *        which read UnityEditor.Selection.gameObjects and loop.  A CONTEXT item
 *        only ever receives the ONE component that was clicked, never the
 *        selection, so the multi-select path cannot live here.
 *     3. single + multi, Project window    -> the same GameObjects/NZK items,
 *        because GameObject menu items also appear for assets dragging a
 *        prefab hierarchy.  Their validators check Selection.activeGameObject,
 *        which is what makes them appear for a Project selection too.
 *
 *   That is why some entries that the user clicks "in the Project window" are
 *   declared here under GameObject/NZK and not under CONTEXT/Assets: a
 *   CONTEXT entry cannot see a multi-selection, so the PROJECT multi-select
 *   case has no CONTEXT form at all.  The item path is Unity's, not ours.
 *
 * WHAT IS *NOT* HERE
 *   The [ContextMenu("...")] attributes on C_NZKToolkit.  Those are instance
 *   methods on the MonoBehaviour and moving them would move the component's
 *   own API.  They are component shortcuts; this file is the CONTEXT/MenuItem
 *   family, which is static.
 *
 * SCOPE
 *   Editor-only throughout - MenuCommand, MenuItem and Undo do not exist in a
 *   player build.
 * ========================================================================== */

#if UNITY_EDITOR
namespace NZK
{
public static partial class Core
{
  /** <summary>Right-click entry points on components and VRCFury features.</summary> */
  public static class RightClick
  {
    /* ── COMPONENT COPY (the one true single-select context item) ────── */

    /** <summary>Clipboard holding the copied component.
     *
     *  PUBLIC, and that is not sloppiness: two files write and read this one
     *  clipboard.  NZK Copy captures here and the toolbar's Paste Component as
     *  New replays it, so a second copy of the fields would give the user two
     *  clipboards that disagree about what was last copied.  Static because the
     *  copy happens on a context click and the paste happens later, possibly
     *  with nothing selected in between.</summary> */
    public static UnityEngine.Component _nzkCopiedComponent;

    /** <summary>JSON snapshot of the copied component, for cross-object paste.
     *  EditorJsonUtility is used rather than the component reference alone so
     *  the paste can land on a DIFFERENT object, including across scenes.</summary> */
    public static System.String _nzkCopiedComponentJson;

    /** <summary>Assembly-qualified type name of the copied component.</summary> */
    public static System.String _nzkCopiedComponentType;

    [UnityEditor.MenuItem("CONTEXT/Component/NZK Copy", false, 200)]
    public static void NzkCopyComponent(UnityEditor.MenuCommand cmd)
    { var comp = cmd.context as UnityEngine.Component;
      if (comp == null) return;
      _nzkCopiedComponent = comp;
      _nzkCopiedComponentType = comp.GetType().FullName;
      _nzkCopiedComponentJson = UnityEditor.EditorJsonUtility.ToJson(comp);
      UnityEngine.Debug.Log("[NZK] Copied " + _nzkCopiedComponentType + " from " + comp.name); }

    [UnityEditor.MenuItem("CONTEXT/Component/NZK Copy", true)]
    public static System.Boolean ValidateNzkCopyComponent(UnityEditor.MenuCommand cmd)
    { return cmd.context is UnityEngine.Component; }

    /* ── VRCFURY: BAKE ───────────────────────────────────────────────── */

    /** <summary>Does this VRCFury component carry the named feature?
     *
     *  Matched by type name CONTAINING the feature name, because the concrete
     *  feature types are internal to VRCFury and their names have changed
     *  between releases.  An exact `==` comparison would silently stop matching
     *  after a VRCFury update and the menu item would just disappear, which is
     *  harder to debug than a log line saying why.</summary> */
    public static System.Boolean HasFeature(UnityEngine.MonoBehaviour comp,System.String featureName)
    { var features = Systems.Baking.GetFeatures(comp);
      if (features == null) return false;
      foreach (var f in features)
        if (f != null && (f.GetType().Name == featureName || (f.GetType().FullName ?? "").Contains(featureName))) return true;
      UnityEngine.Debug.Log("[Baking] This VRCFury component doesn't have a " + featureName + " feature.");
      return false; }

    [UnityEditor.MenuItem("CONTEXT/VRCFury/Bake All VF")]
    public static void ContextBakeAllVf(UnityEditor.MenuCommand cmd)
    { var comp = cmd.context as UnityEngine.MonoBehaviour; if (comp != null) Systems.Baking.BakeAllVf(comp.gameObject); }

    [UnityEditor.MenuItem("CONTEXT/VRCFury/Bake Full Controller")]
    public static void ContextBakeFullController(UnityEditor.MenuCommand cmd)
    { var comp = cmd.context as UnityEngine.MonoBehaviour;
      if (comp != null && HasFeature(comp,"FullController")) Systems.Baking.BakeFullController(comp.gameObject); }

    [UnityEditor.MenuItem("CONTEXT/VRCFury/Bake Armature Link")]
    public static void ContextBakeArmatureLink(UnityEditor.MenuCommand cmd)
    { var comp = cmd.context as UnityEngine.MonoBehaviour;
      if (comp != null && HasFeature(comp,"ArmatureLink")) Systems.Baking.BakeArmatureLink(comp.gameObject); }

    [UnityEditor.MenuItem("CONTEXT/VRCFury/Bake Toggle")]
    public static void ContextBakeToggle(UnityEditor.MenuCommand cmd)
    { var comp = cmd.context as UnityEngine.MonoBehaviour;
      if (comp != null && HasFeature(comp,"Toggle")) Systems.Baking.BakeToggleFromVrcfury(comp.gameObject); }

    /* ── SPS SOCKET ──────────────────────────────────────────────────── */

    [UnityEditor.MenuItem("CONTEXT/VRCFuryHapticSocket/Bake SPS Socket")]
    public static void ContextBakeSpsSocket(UnityEditor.MenuCommand cmd)
    { var comp = cmd.context as UnityEngine.MonoBehaviour; if (comp != null) SpsSocketBaker.Bake(comp.gameObject); }

    [UnityEditor.MenuItem("CONTEXT/C_NzkSpsSocket/Bake SPS Socket")]
    public static void ContextBakeC_NzkSpsSocket(UnityEditor.MenuCommand cmd)
    { var comp = cmd.context as C_NzkSpsSocket; if (comp != null) SpsSocketBaker.Bake(comp.gameObject); }

    [UnityEditor.MenuItem("CONTEXT/C_NzkSpsSocket/Clear Prefab Cache", false, 200)]
    public static void ClearSpsSocketCache(UnityEditor.MenuCommand cmd)
    { var socket = cmd.context as C_NzkSpsSocket; if (socket == null) return;
      var gen = socket.GetComponentInParent<C_SpsSocketGenerator>();
      if (gen == null) { UnityEngine.Debug.Log("[NZK] No generator found for " + socket.name); return; }
      var safe = Vars.Names.Sanitize(socket.name);
      var cached = gen.PrefabsRoot.Find(safe);
      if (cached != null) { UnityEngine.Object.DestroyImmediate(cached.gameObject); UnityEngine.Debug.Log("[NZK] Cleared prefab cache for " + socket.name); }
      UnityEngine.Debug.Log("[NZK] SPS Cache: Cleared cached prefab for " + socket.name + "."); }

    [UnityEditor.MenuItem("CONTEXT/C_NzkSpsSocket/Clear Prefab Cache", true)]
    public static System.Boolean ValidateClearSpsSocketCache(UnityEditor.MenuCommand cmd)
    { return cmd.context is C_NzkSpsSocket; }

    /* ── VRCFURY → NZK CONVERSION ────────────────────────────────────── */

    /** <summary>Copy the serialised fields shared by a VRCFury socket and
     *  C_NzkSpsSocket onto the NZK component.
     *
     *  Driven by a FIELD-NAME list rather than by copying the whole
     *  SerializedObject: the two components share these names by design, and an
     *  explicit list is what makes a renamed field a visible miss instead of a
     *  silent overwrite of something unrelated.  Types are matched per
     *  property so a float in one component lands on the float member of the
     *  other, not on whatever happens to be at the same index.</summary> */
    public static void CopySpsProperties(UnityEngine.Component oldComp,C_NzkSpsSocket nzk)
    { var so = new UnityEditor.SerializedObject(oldComp);
      var fields = new[]{"name","oscId","enableHandTouchZone2","length","unitsInMeters","addMenuItem","enableAuto","position","rotation","addLight","useHipAvoidance","enablePlugLengthParameter","plugLengthParameterName","enablePlugWidthParameter","plugWidthParameterName"};
      var nso = new UnityEditor.SerializedObject(nzk); nso.Update();
      foreach(var f in fields)
      { var sp = so.FindProperty(f); if(sp == null) continue;
        var np = nso.FindProperty(f); if(np == null) continue;
        switch(sp.propertyType)
        { case UnityEditor.SerializedPropertyType.String:  np.stringValue  = sp.stringValue;  break;
          case UnityEditor.SerializedPropertyType.Float:   np.floatValue   = sp.floatValue;   break;
          case UnityEditor.SerializedPropertyType.Integer: np.intValue     = sp.intValue;     break;
          case UnityEditor.SerializedPropertyType.Boolean: np.boolValue    = sp.boolValue;    break;
          case UnityEditor.SerializedPropertyType.Enum:    np.enumValueIndex = sp.enumValueIndex; break;
          case UnityEditor.SerializedPropertyType.Vector3: np.vector3Value = sp.vector3Value; break; } }
      nso.ApplyModifiedProperties();
      if(System.String.IsNullOrEmpty(nzk.name)) nzk.name = nzk.gameObject.name; }

    [UnityEditor.MenuItem("CONTEXT/VRCFuryHapticSocket/Convert to NZK SPS Socket", false, 199)]
    public static void ContextConvertVfToNzk(UnityEditor.MenuCommand cmd)
    { var oldComp = cmd.context as UnityEngine.MonoBehaviour; if (oldComp == null) return;
      var go = oldComp.gameObject; if (go == null) return;
      if (go.GetComponent<C_NzkSpsSocket>() != null)
      { UnityEngine.Debug.LogWarning("[NZK] Convert: Already has NZK SPS Socket. Remove it first."); return; }
      var nzk = go.AddComponent<C_NzkSpsSocket>();
      CopySpsProperties(oldComp,nzk);
      UnityEditor.Undo.RegisterCreatedObjectUndo(nzk,"Convert to NZK SPS Socket");
      UnityEditor.Undo.DestroyObjectImmediate(oldComp);
      EnsureSpsGenerator(go);
      SpsSocketBaker.BakeSingle(go);
      UnityEngine.Debug.Log("[NZK] Converted on " + go.name + " \u2192 C_NzkSpsSocket"); }

    [UnityEditor.MenuItem("CONTEXT/VRCFuryHapticSocket/Convert to NZK SPS Socket", true)]
    public static System.Boolean ValidateContextConvertVfToNzk(UnityEditor.MenuCommand cmd)
    { var c = cmd.context as UnityEngine.Component; return c != null && c.gameObject != null; }

    /* ── SPS GENERATOR (shared by the toolbar's SPS items too) ───────── */

    /** <summary>Make sure the avatar has an SPS generator to hang sockets on.
     *
     *  PUBLIC and reached from NZK.Core.Toolbar: the generator is created as a
     *  side effect of "Create Socket", "Create Plug" and both convert paths, so
     *  it cannot live in either file without the other one calling across.
     *
     *  Resolved through Systems.Baking.GetGenRoot rather than by scanning for a
     *  GEN_ object: that helper is what the bake pipeline itself uses, so the
     *  generator created here is the same one the bake will find.  Typing the
     *  name by hand would produce a second, invisible generator on the frame
     *  the naming convention changed.</summary> */
    public static void EnsureSpsGenerator(UnityEngine.GameObject go)
    { if (go == null || go.transform == null) { UnityEngine.Debug.LogWarning("[NZK] Cannot create SPS generator — null target"); return; }
      var avatarRoot = go.transform.root.gameObject;
      if (avatarRoot == null) { UnityEngine.Debug.LogWarning("[NZK] Cannot create SPS generator — no avatar root for " + go.name); return; }
      var avatarName = Vars.Names.Sanitize(avatarRoot.name);
      var genRoot = Systems.Baking.GetGenRoot(avatarName,avatarRoot);
      if (genRoot == null) { UnityEngine.Debug.LogWarning("[NZK] Cannot create SPS generator — no gen root for " + avatarName); return; }
      var spsChild = genRoot.Find("SPS GENERATOR");
      if (spsChild == null) { var g = new UnityEngine.GameObject("SPS GENERATOR"); g.transform.SetParent(genRoot,false); spsChild = g.transform; }
      var gen = spsChild.GetComponent<C_SpsSocketGenerator>();
      if (gen == null) { gen = spsChild.gameObject.AddComponent<C_SpsSocketGenerator>(); gen.avatarName = avatarName; gen.outputFolder = "Assets/!_NZK_Generated"; }
      UnityEngine.Debug.Log("[NZK] SPS Generator ready for " + avatarName + " at " + genRoot.name); }
  }
}
}
#endif
